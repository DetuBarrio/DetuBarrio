# Conexión principal
DB_URL=jdbc:mysql://localhost:3306/detubarrio?useSSL=false&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=tu_contraseña

# Seguridad
APP_JWT_SECRET=GeneraUnaClaveBase64LargaYAleatoriaAquí
APP_JWT_EXPIRATION=86400

# Contacto
CONTACT_ADMIN_EMAIL=tu-email@ejemplo.com
CONTACT_FROM_EMAIL=no-reply@detubarrio.local

# Cloudinary (IMÁGENES EN PRODUCCIÓN)
# Si no se definen, se usa almacenamiento local (uploads/) como fallback en desarrollo
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_FOLDER=detubarrio

# Email (para contacto y recuperación de contraseña)
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_app
