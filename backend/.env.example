# =============================================================================
# Variables de entorno para DeTuBarrio (Backend Spring Boot)
# Copia este archivo como .env y edita los valores
# =============================================================================

# --- Base de datos (MySQL) ---
DB_URL=jdbc:mysql://tu-host-mysql:3306/detubarrio?useSSL=false&serverTimezone=UTC
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña

# --- Seguridad (JWT) ---
APP_JWT_SECRET=GeneraUnaClaveBase64LargaYAleatoriaAquí
APP_JWT_EXPIRATION=86400

# --- CORS (orígenes permitidos, separados por coma) ---
APP_CORS_ALLOWED_ORIGINS=*

# --- Frontend URL (para enlaces en emails) ---
APP_FRONTEND_URL=https://detubarrio.sitioweb

# --- Contacto ---
CONTACT_ADMIN_EMAIL=tu-email@ejemplo.com
CONTACT_FROM_EMAIL=no-reply@detubarrio.local

# --- Cloudinary (almacenamiento de imágenes) ---
# Si no se definen, se usa almacenamiento local (uploads/) como fallback
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_FOLDER=detubarrio

# --- Email (SMTP Gmail para contacto y recuperación) ---
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_app
